{
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "regions": ["hkg1"],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/metagame",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/player",
      "schedule": "0 */12 * * *"
    },
    {
      "path": "/api/events",
      "schedule": "0 0 * * *"
    }
  ]
}
